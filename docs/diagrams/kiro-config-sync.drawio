<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="steersync" type="device" version="24.0.0">
  <diagram id="kiro-config-sync" name="Kiro configuration sync">
    <mxGraphModel dx="1500" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1040" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;steersync: central Kiro configuration for entra-app-registration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;High level flow between a developer workstation, the project repository and the central kiro-config repository on GitLab&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="lane_ws" value="&lt;b&gt;Developer workstation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#9DB7D5;dashed=1;fontSize=16;fontStyle=1;fontColor=#9DB7D5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="760" height="720" as="geometry"/></mxCell>
        <mxCell id="lane_gl" value="&lt;b&gt;GitLab&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#E0A878;dashed=1;fontSize=16;fontStyle=1;fontColor=#E0A878;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="620" height="720" as="geometry"/></mxCell>
        <mxCell id="kiro" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Kiro CLI (agent sessions)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #7A5AB8;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;loads steering, specs, skills, agents, hooks and settings from .kiro/ and ~/.kiro/&lt;br&gt;SessionStart hook runs steersync pull; the MCP server exposes pull, push, diff and lint&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A5AB8;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="640" height="95" as="geometry"/></mxCell>
        <mxCell id="proj" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Project clone: entra-app-registration&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #4A77B4;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;Application code (Groovy plugins, Terraform)&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;.kiro/steering/&amp;nbsp;&amp;nbsp; specs/&amp;nbsp;&amp;nbsp; skills/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;.kiro/agents/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; hooks/&amp;nbsp;&amp;nbsp; settings/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;.kiro/steersync.lock.json&lt;/span&gt;&lt;br&gt;(hash of every synced file, per collection)&lt;br&gt;&amp;nbsp;&lt;br&gt;.kiro/ is in .git/info/exclude, so it is never&lt;br&gt;committed to the project repository&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A77B4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="330" height="195" as="geometry"/></mxCell>
        <mxCell id="home" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Global Kiro home: ~/.kiro/&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #4A77B4;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;steering/&amp;nbsp;&amp;nbsp;skills/&amp;nbsp;&amp;nbsp;agents/&amp;nbsp;&amp;nbsp;hooks/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;steersync.lock.json&lt;/span&gt;&lt;br&gt;applied to every workspace&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A77B4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="245" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="ss" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;steersync CLI  (uv tool install steersync)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #1F8A70;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;config: ~/.config/steersync/config.yaml&amp;nbsp;&amp;nbsp;(remote.url, allowed_hosts, collections)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;cache clone: ~/.cache/steersync/repos/&amp;lt;sha&amp;gt;&amp;nbsp;&amp;nbsp;(shallow, locked, git hooks disabled)&lt;/span&gt;&lt;br&gt;lints each collection with its profile, plans add / update / delete / conflict per file&lt;br&gt;shells out to the git binary: the SSH agent or credential helper does the authentication&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#1F8A70;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="640" height="150" as="geometry"/></mxCell>
        <mxCell id="hook" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;git pre-push hook  (steersync init --hook)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #4A77B4;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;runs steersync push --from-hook on each push&lt;br&gt;never blocks the push unless strict mode is on&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A77B4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="dev" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Developer&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #C9A227;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;edits .kiro/ while working with Kiro&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;git push&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;steersync push&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;steersync pull&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#C9A227;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="projrepo" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Project repository: acme/platform/entra-app-registration&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #D8732E;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;application code only, with the service&amp;#x27;s own CI/CD&lt;br&gt;the origin URL gives the project slug used in the central repository&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8732E;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="560" height="95" as="geometry"/></mxCell>
        <mxCell id="central" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Central repository: platform/kiro-config&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #D8732E;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;main&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;&amp;nbsp;&amp;nbsp;global/steering/&amp;nbsp;&amp;nbsp; global/skills/&amp;nbsp;&amp;nbsp; global/agents/&amp;nbsp;&amp;nbsp; global/hooks/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;&amp;nbsp;&amp;nbsp;projects/acme/platform/entra-app-registration/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;steering/&amp;nbsp;&amp;nbsp;specs/&amp;nbsp;&amp;nbsp;skills/&amp;nbsp;&amp;nbsp;agents/&amp;nbsp;&amp;nbsp;hooks/&amp;nbsp;&amp;nbsp;settings/&lt;/span&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;proposal branch&amp;nbsp;&amp;nbsp;steering/&amp;lt;project&amp;gt;/&amp;lt;user&amp;gt;-&amp;lt;hash&amp;gt;&lt;/span&gt;&lt;br&gt;  one commit carrying every changed collection&lt;br&gt;  git push options open the merge request automatically&lt;br&gt;&amp;nbsp;&lt;br&gt;merge request: reviewed like code, then merged to main&lt;br&gt;the project slug and the collection directories make the diff self explanatory&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8732E;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="245" width="560" height="315" as="geometry"/></mxCell>
        <mxCell id="reviewer" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Reviewers (platform and security owners)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #C9A227;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;review the proposal like any code change&lt;br&gt;after the merge, every workstation receives it on its next steersync pull&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#C9A227;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="680" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b style=&quot;font-size:14px;color:#1F2933&quot;&gt;Tooling and commands, in order&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #C9A227;margin:4px 0&quot;&gt;&lt;span style=&quot;color:#52606D&quot;&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;1&amp;nbsp;&amp;nbsp;uv tool install steersync;&amp;nbsp;&amp;nbsp;write ~/.config/steersync/config.yaml (remote.url, allowed_hosts);&amp;nbsp;&amp;nbsp;steersync config validate;&amp;nbsp;&amp;nbsp;steersync doctor&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;2&amp;nbsp;&amp;nbsp;cd entra-app-registration;&amp;nbsp;&amp;nbsp;steersync init --hook;&amp;nbsp;&amp;nbsp;steersync kiro-hook --write;&amp;nbsp;&amp;nbsp;steersync mcp-config&amp;nbsp;&amp;nbsp;(into .kiro/settings/mcp.json)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;3&amp;nbsp;&amp;nbsp;steersync pull&amp;nbsp;&amp;nbsp;(every collection, or -c steering -c skills);&amp;nbsp;&amp;nbsp;steersync status;&amp;nbsp;&amp;nbsp;steersync lint&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;4&amp;nbsp;&amp;nbsp;edit .kiro/ ...;&amp;nbsp;&amp;nbsp;git push&amp;nbsp;&amp;nbsp;(the pre-push hook runs steersync push --from-hook)&amp;nbsp;&amp;nbsp;or&amp;nbsp;&amp;nbsp;steersync push -m &amp;quot;...&amp;quot;&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;merge request in kiro-config&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:JetBrains Mono;font-size:12px&quot;&gt;5&amp;nbsp;&amp;nbsp;review and merge in GitLab&amp;nbsp;&amp;nbsp;-&amp;gt;&amp;nbsp;&amp;nbsp;every workstation receives the change on its next steersync pull (session start, pre-push, manual or scheduled)&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#C9A227;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="1440" height="140" as="geometry"/></mxCell>
        <mxCell id="e_kiro_proj" value="loads .kiro/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A5AB8;strokeWidth=2;fontColor=#7A5AB8;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="kiro" target="proj"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="205" as="sourcePoint"/><mxPoint x="160" y="245" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_kiro_home" value="loads ~/.kiro/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A5AB8;strokeWidth=2;fontColor=#7A5AB8;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="kiro" target="home"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="205" as="sourcePoint"/><mxPoint x="560" y="245" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_kiro_ss" value="3  SessionStart hook and MCP tools call steersync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7A5AB8;strokeWidth=2;fontColor=#7A5AB8;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="kiro" target="ss"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="160" as="sourcePoint"/><mxPoint x="60" y="600" as="targetPoint"/><Array as="points"><mxPoint x="45" y="160"/><mxPoint x="45" y="600"/></Array></mxGeometry></mxCell>
        <mxCell id="e_proj_ss" value="4  snapshot + lint .kiro/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="proj" target="ss"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="440" as="sourcePoint"/><mxPoint x="140" y="490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_ss_proj" value="3  write, prune, keep local edits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ss" target="proj"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="490" as="sourcePoint"/><mxPoint x="330" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_home_ss" value="snapshot ~/.kiro/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="home" target="ss"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="375" as="sourcePoint"/><mxPoint x="520" y="490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_ss_home" value="3  write global collections" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ss" target="home"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="490" as="sourcePoint"/><mxPoint x="640" y="375" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_hook_ss" value="steersync push --from-hook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hook" target="ss"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="680" as="sourcePoint"/><mxPoint x="225" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_dev_hook" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A77B4;strokeWidth=2;fontColor=#4A77B4;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dev" target="hook"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="762" as="sourcePoint"/><mxPoint x="390" y="762" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_dev_projrepo" value="4  git push (application code)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A77B4;strokeWidth=2;fontColor=#4A77B4;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dev" target="projrepo"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="700" as="sourcePoint"/><mxPoint x="880" y="150" as="targetPoint"/><Array as="points"><mxPoint x="820" y="700"/><mxPoint x="820" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="e_central_ss" value="3  pull: fetch main, then apply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="central" target="ss"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="515" as="sourcePoint"/><mxPoint x="700" y="515" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_ss_central" value="4  push: proposal branch + MR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F8A70;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ss" target="central"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="550" as="sourcePoint"/><mxPoint x="880" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_review" value="5  review, approve, merge to main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D8732E;strokeWidth=2;fontColor=#D8732E;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reviewer" target="central"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="680" as="sourcePoint"/><mxPoint x="1160" y="560" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
