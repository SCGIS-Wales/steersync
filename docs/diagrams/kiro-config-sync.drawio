<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="steersync" type="device" version="24.0.0">
  <diagram id="kiro-config-sync" name="Kiro configuration sync">
    <mxGraphModel dx="1400" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="780" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:26px&quot;&gt;Central Kiro configuration with steersync&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#52606D&quot;&gt;One reviewed copy in GitLab, applied to every workstation&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="800" height="70" as="geometry"/></mxCell>
        <mxCell id="gitlab" value="&lt;b style=&amp;quot;color:#D8732E&amp;quot;&gt;GitLab&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="900" y="70" width="200" height="30" as="geometry"/></mxCell>
        <mxCell id="footer" value="steersync init --hook   |   steersync pull   |   edit .kiro/ ... git push  (hook runs steersync push)   |   review and merge in GitLab" style="text;html=1;align=left;fontSize=14;fontFamily=JetBrains Mono;fontColor=#52606D;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1280" height="40" as="geometry"/></mxCell>
        <mxCell id="ws" value="&lt;b&gt;Developer workstation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FB;strokeColor=#9DB7D5;dashed=1;fontSize=18;fontColor=#9DB7D5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="440" height="380" as="geometry"/></mxCell>
        <mxCell id="kiro" value="&lt;b style=&quot;font-size:17px&quot;&gt;Kiro CLI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;reads .kiro/ and ~/.kiro/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A5AB8;strokeWidth=2;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="kirodir" value="&lt;b style=&quot;font-size:17px&quot;&gt;.kiro/ in the project clone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;steering, specs, skills, agents, hooks, settings&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A77B4;strokeWidth=2;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="ss" value="&lt;b style=&quot;font-size:17px&quot;&gt;steersync&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;pull, push, lint; git pre-push hook&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F1;strokeColor=#1F8A70;strokeWidth=2;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="projrepo" value="&lt;b style=&quot;font-size:17px&quot;&gt;Project repository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;entra-app-registration: application code only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8732E;strokeWidth=2;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="central" value="&lt;b&gt;Central repository: kiro-config&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#D8732E;dashed=1;fontSize=18;fontColor=#D8732E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="900" y="310" width="440" height="240" as="geometry"/></mxCell>
        <mxCell id="main" value="&lt;b style=&quot;font-size:17px&quot;&gt;main&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;global/  and  projects/&amp;lt;project&amp;gt;/&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8732E;strokeWidth=2;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="930" y="370" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="mr" value="&lt;b style=&quot;font-size:17px&quot;&gt;merge request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#52606D&quot;&gt;reviewed by platform and security owners&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8732E;strokeWidth=2;fontColor=#1F2933;" vertex="1" parent="1"><mxGeometry x="930" y="460" width="380" height="60" as="geometry"/></mxCell>
        <mxCell id="e_code" value="git push (code)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A77B4;strokeWidth=2.5;fontColor=#4A77B4;fontSize=14;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ws" target="projrepo"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="200" as="sourcePoint"/><mxPoint x="900" y="155" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_push" value="steersync push: opens a merge request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2.5;fontColor=#1F8A70;fontSize=14;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ss" target="mr"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="490" as="sourcePoint"/><mxPoint x="930" y="490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_merge" value="review, merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D8732E;strokeWidth=2.5;fontColor=#D8732E;fontSize=14;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mr" target="main"><mxGeometry relative="1" as="geometry"><mxPoint x="1120" y="460" as="sourcePoint"/><mxPoint x="1120" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="e_pull" value="steersync pull: applies merged main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F8A70;strokeWidth=2.5;fontColor=#1F8A70;fontSize=14;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="main" target="kirodir"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="385" as="sourcePoint"/><mxPoint x="500" y="385" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
