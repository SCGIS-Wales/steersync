{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Required: title, domain, type, status, verified_on. Steering keys are forbidden.",
  "properties": {
    "aliases": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "domain": {
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "related": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Related",
      "type": "array"
    },
    "relations": {
      "default": [],
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Relations",
      "type": "array"
    },
    "review_by": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review By"
    },
    "sources": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "verified_on": {
      "format": "date",
      "title": "Verified On",
      "type": "string"
    }
  },
  "required": [
    "title",
    "domain",
    "type",
    "status",
    "verified_on"
  ],
  "title": "KnowledgeNote",
  "type": "object"
}
