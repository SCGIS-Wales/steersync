{
  "$defs": {
    "AgentHook": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "additionalProperties": true,
          "title": "Action",
          "type": "object"
        },
        "matcher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matcher"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "action"
      ],
      "title": "AgentHook",
      "type": "object"
    },
    "KnowledgeBaseResource": {
      "additionalProperties": false,
      "properties": {
        "autoUpdate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autoupdate"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "indexType": {
          "anyOf": [
            {
              "enum": [
                "best",
                "fast"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indextype"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "pattern": "^file://",
          "title": "Source",
          "type": "string"
        },
        "type": {
          "const": "knowledgeBase",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "source",
        "name"
      ],
      "title": "KnowledgeBaseResource",
      "type": "object"
    },
    "PermissionRule": {
      "additionalProperties": true,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "effect": {
          "enum": [
            "allow",
            "ask",
            "deny",
            "evaluate"
          ],
          "title": "Effect",
          "type": "string"
        },
        "exclude": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude"
        },
        "match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        }
      },
      "required": [
        "capability",
        "effect"
      ],
      "title": "PermissionRule",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": true,
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "Permissions",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Top level keys Kiro V3 reads; lint reports any other key (agent-unknown-key).",
  "properties": {
    "allowedTools": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowedtools"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "excludedTools": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excludedtools"
    },
    "hooks": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AgentHook"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hooks"
    },
    "includeMcpJson": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Includemcpjson"
    },
    "includePowers": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Includepowers"
    },
    "kiroUpgrade": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kiroupgrade"
    },
    "mcpServers": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mcpservers"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "permissions": {
      "anyOf": [
        {
          "$ref": "#/$defs/Permissions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt"
    },
    "resources": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/KnowledgeBaseResource"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resources"
    },
    "tools": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tools"
    },
    "toolsSettings": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Toolssettings"
    },
    "welcomeMessage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Welcomemessage"
    }
  },
  "title": "AgentConfig",
  "type": "object"
}
